        "custom_liquid_cFqYBf": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n.ai-suite-section {\n  background: #ffffff;\n  padding: 0px;\n  font-family: Arial, sans-serif;\n}\n\n.ai-suite-container {\n  max-width: 1200px;\n  margin: 0 auto;\n}\n\n.ai-suite-text {\n  color: #000000;\n  font-size: 20px;\n  line-height: 1.7;\n  max-width: 950px;\n  margin-bottom: 20px;\n}\n\n.ai-suite-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(250px, 1fr));\n  gap: 10px 20px;\n}\n\n.ai-suite-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 16px;\n}\n\n.ai-suite-icon {\n  width: 28px;\n  height: 28px;\n  background: #000;\n  color: #fff;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 15px;\n  flex-shrink: 0;\n  margin-top: 3px;\n}\n\n.ai-suite-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: #111827;\n  line-height: 1.4;\n}\n\n@media screen and (max-width: 768px) {\n  .ai-suite-section {\n    padding: 40px 20px;\n  }\n\n  .ai-suite-text {\n    font-size: 17px;\n  }\n\n  .ai-suite-grid {\n    grid-template-columns: 1fr;\n    gap: 25px;\n  }\n\n  .ai-suite-title {\n    font-size: 18px;\n  }\n}\n<\/style>\n\n<section class=\"ai-suite-section\">\n  <div class=\"ai-suite-container\">\n\n    <!-- Table Description -->\n    <div class=\"ai-suite-text\">\n      {{ product.metafields.custom.table_description }}\n    <\/div>\n\n    <div class=\"ai-suite-grid\">\n\n      <!-- Feature 1 -->\n      <div class=\"ai-suite-item\">\n        <div class=\"ai-suite-icon\">✓<\/div>\n        <div class=\"ai-suite-title\">\n          {{ product.metafields.custom.feature_1 }}\n        <\/div>\n      <\/div>\n\n      <!-- Feature 2 -->\n      <div class=\"ai-suite-item\">\n        <div class=\"ai-suite-icon\">✓<\/div>\n        <div class=\"ai-suite-title\">\n          {{ product.metafields.custom.feature_2 }}\n        <\/div>\n      <\/div>\n\n      <!-- Feature 3 -->\n      <div class=\"ai-suite-item\">\n        <div class=\"ai-suite-icon\">✓<\/div>\n        <div class=\"ai-suite-title\">\n          {{ product.metafields.custom.feature_3 }}\n        <\/div>\n      <\/div>\n\n      <!-- Feature 4 -->\n      <div class=\"ai-suite-item\">\n        <div class=\"ai-suite-icon\">✓<\/div>\n        <div class=\"ai-suite-title\">\n          {{ product.metafields.custom.feature_4 }}\n        <\/div>\n      <\/div>\n\n    <\/div>\n\n  <\/div>\n<\/section>"
          }
