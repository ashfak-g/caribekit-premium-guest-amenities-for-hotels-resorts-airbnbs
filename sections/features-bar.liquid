        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SUSTAINABLE"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "ECO-CONSCIOUS CHOICES"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
