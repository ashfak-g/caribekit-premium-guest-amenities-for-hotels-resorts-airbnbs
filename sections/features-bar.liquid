{%- style -%}
/* ===== TRUST BADGES SECTION ===== */
#shopify-section-{{ section.id }} {
  -webkit-font-smoothing: antialiased;
}
.tb-section-{{ section.id }} {
  padding: 1.5rem 0;
  background-color: #FAF5EB;
}
@media (min-width: 768px) {
  .tb-section-{{ section.id }} {
    padding: 2.25rem 0;
  }
}

.tb-grid-{{ section.id }} {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding-left: 20px;
  gap: 1rem;
  padding-bottom: 1rem;
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.tb-grid-{{ section.id }}::-webkit-scrollbar {
  display: none;
}
@media (min-width: 768px) {
  .tb-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    overflow-x: visible;
    padding-bottom: 0;
  }
}
.tb-col-{{ section.id }} {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  position: relative;
  flex: 0 0 75%; /* Cards take up 75% of screen on mobile */
  scroll-snap-align: start;
}
@media (min-width: 768px) {
  .tb-col-{{ section.id }} {
    flex: auto;
    justify-content: center;
  }
}
.tb-col-{{ section.id }}:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 15%;
  bottom: 15%;
  width: 2px;
  background-color: currentColor;
  opacity: 0.4; /* vertical divider */
}
.tb-item-{{ section.id }} {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  padding: 0 1rem;
}
.tb-icon-{{ section.id }} {
  flex-shrink: 0;
  color: inherit;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tb-icon-{{ section.id }} img,
.tb-icon-{{ section.id }} svg {
  max-width: 34px;
  max-height: 34px;
}
.tb-text-{{ section.id }} {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.tb-title-{{ section.id }} {
  font-size: 0.8125rem; /* 13px */
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: inherit;
  margin: 0;
  line-height: 1.2;
}
.tb-subtitle-{{ section.id }} {
  font-size: 0.625rem; /* 10px */
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: inherit;
  opacity: 0.7;
  margin: 0;
  line-height: 1.2;
}
{%- endstyle -%}
{%- liquid
  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif
  if container == blank
    assign container = 'container-fluid'
  endif
-%}
<section id="tb-{{ section.id }}" class="tb-section-{{ section.id }} m-section m-color-{{ section.settings.color_scheme | default: 'background-1' }}">
  <div class="{{ container }}">
    <div class="tb-grid-{{ section.id }}">
      
      {%- for block in section.blocks -%}
        <div class="tb-col-{{ section.id }}" {{ block.shopify_attributes }}>
          <div class="tb-item-{{ section.id }}">
            <div class="tb-icon-{{ section.id }}">
              {%- if block.settings.icon_image != blank -%}
                <img src="{{ block.settings.icon_image | image_url: width: 68 }}" alt="{{ block.settings.title | escape }}" width="34" height="34" style="object-fit: contain;">
              {%- elsif block.settings.icon_svg != blank -%}
                {{ block.settings.icon_svg }}
              {%- endif -%}
            </div>
            <div class="tb-text-{{ section.id }}">
              <h4 class="tb-title-{{ section.id }}">{{ block.settings.title }}</h4>
              <p class="tb-subtitle-{{ section.id }}">{{ block.settings.subtitle }}</p>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Trust Badges",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container-fluid",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default"
        },
        {
          "value": "w-full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Use container box"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
