        { "type": "text", "id": "t2_val", "label": "Row 2 Value", "default": "Soothes scalp" },
        { "type": "text", "id": "t3_name", "label": "Row 3 Name", "default": "Vitamin E" },
        { "type": "text", "id": "t3_val", "label": "Row 3 Value", "default": "Antioxidant protection" },
        { "type": "text", "id": "t4_name", "label": "Row 4 Name", "default": "Citrus Oil" },
        { "type": "text", "id": "t4_val", "label": "Row 4 Value", "default": "Natural fragrance" },
        {
          "type": "header",
