{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-product-inventory.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign product_id = product.id
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign remove_params = section.settings.remove_params

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign classes = 'm-section m:block m-product-recommendations m-swiper-overflow m-gradient m-color-' | append: section.settings.color_scheme
  if section.settings.custom_class != blank
    assign classes = classes | append: ' ' | append: section.settings.custom_class
  endif
-%}

{%- capture gridClass -%}
  m:grid-2-cols md:m:grid-{{ section.settings.columns | minus: 1 }}-cols xl:m:grid-{{ section.settings.columns }}-cols
{%- endcapture -%}

{%- style -%}
  #m-section--{{ section.id }} {
    --column-gap: {{ section.settings.column_gap }}px;
    --column-gap-mobile: 16px;
    --row-gap: {{ section.settings.column_gap | plus: 10 }}px;
    --row-gap-mobile: 30px; --items: {{ section.settings.columns }};
    padding-top: calc({{ section.settings.padding_top }}px * 0.7);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.7);
  }
  @media (min-width: 768px) {
    #m-section--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #m-section--{{ section.id }} .m-product-card {
    --fa-style-family-brands: "Font Awesome 6 Brands";
    --fa-font-brands: normal 400 1em/1 "Font Awesome 6 Brands";
    --fa-font-regular: normal 400 1em/1 "Font Awesome 6 Free";
    --fa-style-family-classic: "Font Awesome 6 Free";
    --fa-font-solid: normal 900 1em/1 "Font Awesome 6 Free";
    --bg: #FFFBF5;
    --surface: #FFFFFF;
    --text: #1A1A1A;
    --text-soft: #5A5A5A;
    --border: #E8E0D5;
    --coral: #FF7F5C;
    --coral-dark: #E86542;
    --teal: #1A4D5F;
    --teal-dark: #143945;
    --green: #2D6A4F;
    --gold: #FFB800;
    --radius-card: 20px;
    --radius-img: 16px;
    --radius-pill: 40px;
    --shadow-sm: 0 2px 8px rgba(26,26,26,.04);
    --shadow-md: 0 8px 24px rgba(26,26,26,.08);
    --shadow-lg: 0 20px 60px rgba(26,26,26,.12);
    --t: .2s ease;
    
    background: var(--surface);
    padding: 15px;
    border-radius: var(--radius-img);
    box-shadow: var(--shadow-sm);
  }
  
  #m-section--{{ section.id }} .m-product-card .m-price-item,
  #m-section--{{ section.id }} .m-product-card .m-price {
    color: #000000 !important;
  }
  
  #m-section--{{ section.id }} .m-product-card .spr-icon,
  #m-section--{{ section.id }} .m-product-card .jdgm-star,
  #m-section--{{ section.id }} .m-product-card .loox-rating-icon,
  #m-section--{{ section.id }} .m-product-card [class*="star"],
  #m-section--{{ section.id }} .m-product-card [class*="icon-star"] {
    color: #000000 !important;
  }
{%- endstyle -%}
<section
  id="m-section--{{ section.id }}"
  class="{{ classes }}"
>
  <product-recommendations
    data-items-per-page="{{ section.settings.columns }}"
    data-enable-slider="{{ section.settings.enable_slider }}"
    data-use-scroll-mobile="{{ section.settings.use_scroll_mobile }}"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product_id }}&limit={{ section.settings.limit | default: 4 }}"
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <div class="{{ container }}">
        {% assign default_heading = 'products.product.product_recommendation_heading' | t %}
        <div class="m-section__header m:text-{{ section.settings.text_align | default: 'left' }}">
          <h2 class="m-section__heading {{ section.settings.heading_size }}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
            {{ section.settings.heading | default: default_heading }}
          </h2>
        </div>
        <div class="m-product-recommendations__wrapper m-slider-control-hover-inside m-mixed-layout{% if section.settings.use_scroll_mobile %} m-mixed-layout--mobile-scroll{% endif %}">
          <div class="m-product-list {% if section.settings.enable_slider %} swiper-container{% endif %}">
            <div class="m:grid {{ gridClass | strip_newlines }} m-mixed-layout__inner{% if section.settings.enable_slider %} swiper-wrapper{% endif %}">
              {% for product in recommendations.products %}
                <div class="m:column swiper-slide">
                  {% liquid
                    case settings.pcard_layout
                      when '1'
                        render 'product-card-1', product: product, index: forloop.index, animated: animated, animation_effect: animation_effect, remove_params: remove_params
                      when '2'
                        render 'product-card-2', product: product, index: forloop.index, animated: animated, animation_effect: animation_effect, remove_params: remove_params
                      when '3'
                        render 'product-card-3', product: product, index: forloop.index, animated: animated, animation_effect: animation_effect, remove_params: remove_params
                      when '4'
                        render 'product-card-4', product: product, index: forloop.index, animated: animated, animation_effect: animation_effect, remove_params: remove_params
                      when '5'
                        render 'product-card-5', product: product, index: forloop.index, animated: animated, animation_effect: animation_effect, remove_params: remove_params
                    endcase
                  %}
                </div>
              {% endfor %}
            </div>
          </div>
          {% if section.settings.enable_slider %}
            {% render 'slider-controls',
              absolute: true,
              show_nav: true,
              container: section.settings.container,
              nav_class: 'm:hidden'
            %}
          {% endif %}
        </div>
      </div>
    {% endif %}
  </product-recommendations>
</section>

{% schema %}
{
  "name": "Product recommendations",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default"
        },
        {
          "value": "w-full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Use container box"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "checkbox",
      "id": "remove_params",
      "label": "Remove URL params",
      "default": false,
      "info": "Remove param tracking in product URL"
    },
    {
      "type": "header",
      "content": "Header settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You Might Also Like",
      "placeholder": "Product recommendations"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h2",
          "label": "Large"
        }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "content": "Grid settings"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "default": 8,
      "min": 3,
      "max": 20
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row",
      "default": 4,
      "min": 3,
      "max": 8
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "default": 30,
      "min": 0,
      "max": 50,
      "step": 2
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable slider",
      "default": true
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "checkbox",
      "id": "use_scroll_mobile",
      "label": "Use horizontal scrollbar",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Custom Attributes"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom classes"
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Visible in the view animation",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit global setting"
        },
        {
          "value": "fade-in",
          "label": "Fade in"
        },
        {
          "value": "fade-in-up",
          "label": "Fade in up"
        },
        {
          "value": "fade-in-left",
          "label": "Fade in left"
        },
        {
          "value": "fade-in-right",
          "label": "Fade in right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
