{% comment %}
  Section: Testimonials
  Style: Caribe Kit — Trusted by the Best
  Layout: Centered heading + 3-column cards, decorative circle BG
{% endcomment %}

{%- liquid
  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif
  if container == blank
    assign container = 'container-fluid'
  endif
-%}
<section class="tp-section m-section m-color-{{ section.settings.color_scheme | default: 'background-1' }}" id="testimonials-{{ section.id }}">



  <div class="{{ container }}">
  <!-- Heading -->
  <div class="tp-header">
    {% if section.settings.label != blank %}
      <p class="tp-label">{{ section.settings.label }}</p>
    {% endif %}
    <h2 class="tp-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.description != blank %}
      <p class="tp-description">{{ section.settings.description }}</p>
    {% endif %}
  </div>

  <!-- Cards Grid -->
  <div class="tp-grid" role="list">
    {% for block in section.blocks %}
      {% if block.type == 'partner' %}
        <article class="tp-card" role="listitem" {{ block.shopify_attributes }}>
          <h3 class="tp-partner-title">{{ block.settings.title }}</h3>
        </article>
      {% endif %}
    {% endfor %}
  </div>
  </div>

</section>

<style>
  .tp-section {
    position: relative;
    padding-top: calc({{ section.settings.padding_top }}px * 0.7);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.7);
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .tp-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }



  /* ── Header ── */
  .tp-header {
    position: relative;
    z-index: 1;
    text-align: center;
    margin-bottom: {{ section.settings.header_gap }}px;
  }

  .tp-label {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.8;
    margin-bottom: 10px;
  }

  .tp-heading {
    font-size: 36px !important;
    font-weight: 400;
    color: inherit;
    margin: 0;
    line-height: 1.15;
  }
  @media (max-width: 768px) {
    .tp-heading {
      font-size: 25px !important;
    }
  }

  .tp-description {
    font-size: 18px;
    color: inherit;
    opacity: 0.8;
    margin: 15px auto 0;
    max-width: 600px;
    line-height: 1.6;
  }

  /* ── Grid ── */
  .tp-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
    align-items: stretch;
  }

  /* ── Card ── */
  .tp-card {
    background-color: #FAF5EB;
    border-radius: {{ section.settings.card_radius }}px;
    padding: 36px !important;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: center;
    align-items: center;
    text-align: center;
    box-shadow: 0 2px 20px rgba(0,0,0,0.06);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .tp-card:hover {
    box-shadow: 0 8px 36px rgba(0,0,0,0.10);
    transform: translateY(-2px);
  }

  .tp-partner-title {
    font-size: {{ section.settings.title_font_size | default: 20 }}px;
    font-weight: 600;
    color: inherit;
    margin: 0;
    line-height: 1.3;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .tp-section { padding-left: 24px; padding-right: 24px; }
    .tp-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 767px) {
    .tp-grid { 
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-left: 24px;
      gap: 16px;
      margin-left: -24px;
      margin-right: -24px;
      padding-left: 24px;
      padding-right: 24px;
      padding-bottom: 20px;
      -ms-overflow-style: none;
      scrollbar-width: none;
      align-items: stretch;
    }
    .tp-grid::-webkit-scrollbar {
      display: none;
    }
    .tp-card {
      flex: 0 0 85%;
      scroll-snap-align: start;
    }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "testimonials-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label (above heading, optional)",
      "default": "OUR PARTNERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted Across Caribbean Hospitality"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Trusted by growing hospitality partners across the Caribbean."
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "Gap below heading (px)",
      "min": 20,
      "max": 80,
      "step": 4,
      "default": 48
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container-fluid",
      "options": [
        { "value": "container-fluid", "label": "Default" },
        { "value": "w-full", "label": "Full width" },
        { "value": "container", "label": "Use container box" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between cards (px)",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 140,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 140,
      "step": 5,
      "default": 80
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card Inner Padding (px)",
      "min": 16,
      "max": 60,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Border Radius (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title font size (px)",
      "min": 16,
      "max": 32,
      "step": 1,
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "partner",
      "name": "Partner",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Hotels"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trusted Partners",
      "settings": {
        "label": "OUR PARTNERS",
        "heading": "Trusted Across Caribbean Hospitality",
        "description": "Trusted by growing hospitality partners across the Caribbean.",
        "columns": 4
      },
      "blocks": [
        { "type": "partner", "settings": { "title": "Hotels" } },
        { "type": "partner", "settings": { "title": "Airbnb Hosts" } },
        { "type": "partner", "settings": { "title": "Boutique Stays" } },
        { "type": "partner", "settings": { "title": "Vacation Rentals" } }
      ]
    }
  ]
}
{% endschema %}
