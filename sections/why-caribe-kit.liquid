{%- style -%}
/* ===== WHY CARIBE KIT SECTION ===== */
#shopify-section-{{ section.id }} {
  --teal: #000000;
  --coral: #000000;
  --sand-50: #faf5eb; /* Lighter sand for cards */
  --cream: #fffbf5;
  --charcoal: #000000;
  -webkit-font-smoothing: antialiased;
}
.wck-section-{{ section.id }} {
  background-color: #FAF5EB;
  padding-top: calc({{ section.settings.padding_top }}px * 0.7);
  padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.7);
}
@media (min-width: 768px) {
  .wck-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

/* ─── Header ─── */
.wck-header-{{ section.id }} {
  text-align: left;
  margin-bottom: 3rem;
  max-width: 42rem;
}
@media (min-width: 768px) {
  .wck-header-{{ section.id }} {
    margin-bottom: 4rem;
  }
}
.wck-eyebrow-{{ section.id }} {
  display: inline-block;
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--coral);
  margin-bottom: 0.5rem;
}
.wck-heading-{{ section.id }} {
  color: var(--teal);
  margin: 0;
}
/* ─── Grid ─── */
.wck-grid-{{ section.id }} {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding-left: 20px;
  gap: 1.25rem;
  padding-bottom: 1.5rem;
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.wck-grid-{{ section.id }}::-webkit-scrollbar {
  display: none;
}
@media (min-width: 768px) {
  .wck-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    overflow-x: visible;
    padding-bottom: 0;
  }
}
/* ─── Card ─── */
.wck-card-{{ section.id }} {
  background-color: #ffffff;
  border-radius: 1rem;
  padding: 1.5rem;
  text-align: left;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  flex: 0 0 85%;
  scroll-snap-align: start;
}
@media (min-width: 768px) {
  .wck-card-{{ section.id }} {
    padding: 2rem;
    flex: auto;
  }
}
.wck-card-{{ section.id }}:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
}
/* ─── Hover Effects Removed ─── */
.wck-icon-wrap-{{ section.id }} {
  width: 4rem;
  height: 4rem;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999px;
  background-color: #FAF5EB;
  font-size: 1.875rem;
  transition: background-color 0.3s ease, color 0.3s ease;
  color: var(--charcoal);
}
.wck-icon-wrap-{{ section.id }} svg {
  width: 1.5rem;
  height: 1.5rem;
  fill: currentColor;
}
.wck-card-title-{{ section.id }} {
  color: var(--teal);
  margin: 0 0 0.75rem 0;
  transition: color 0.3s ease;
}
.wck-card-desc-{{ section.id }} {
  color: #000000;
  margin: 0;
  transition: color 0.3s ease;
}
{%- endstyle -%}
{%- liquid
  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif
  if container == blank
    assign container = 'container-fluid'
  endif
-%}
<section id="wck-{{ section.id }}" class="wck-section-{{ section.id }} m-section m-color-{{ section.settings.color_scheme | default: 'background-1' }}">
  <div class="{{ container }}">
    
    {%- comment -%}── Section Header ──{%- endcomment -%}
    <div class="wck-header-{{ section.id }}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="wck-eyebrow-{{ section.id }}">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="wck-heading-{{ section.id }} {{ section.settings.heading_size | default: 'h2' }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- comment -%}── Features Grid ──{%- endcomment -%}
    <div class="wck-grid-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="wck-card-{{ section.id }}" {{ block.shopify_attributes }}>
          <div class="wck-icon-wrap-{{ section.id }}">
            {%- if block.settings.icon_image != blank -%}
              <img src="{{ block.settings.icon_image | image_url: width: 60 }}" alt="{{ block.settings.title | escape }}" width="24" height="24" style="object-fit: contain;">
            {%- elsif block.settings.icon_svg != blank -%}
              {{ block.settings.icon_svg }}
            {%- else -%}
              <span aria-hidden="true">{{ block.settings.icon }}</span>
            {%- endif -%}
          </div>
          <h3 class="wck-card-title-{{ section.id }}">{{ block.settings.title }}</h3>
          <p class="wck-card-desc-{{ section.id }}">{{ block.settings.text }}</p>
        </div>
      {%- else -%}
        {%- comment -%} Fallback if no blocks are added {%- endcomment -%}
        <div class="wck-card-{{ section.id }}">
          <div class="wck-icon-wrap-{{ section.id }}"><span aria-hidden="true">🌊</span></div>
          <h3 class="wck-card-title-{{ section.id }}">Dermatologically tested</h3>
          <p class="wck-card-desc-{{ section.id }}">Skin-safe formulations approved by independent dermatologists.</p>
        </div>
        <div class="wck-card-{{ section.id }}">
          <div class="wck-icon-wrap-{{ section.id }}"><span aria-hidden="true">🧴</span></div>
          <h3 class="wck-card-title-{{ section.id }}">Cruelty-free & vegan</h3>
          <p class="wck-card-desc-{{ section.id }}">Never tested on animals. 100% vegan ingredients across the range.</p>
        </div>
        <div class="wck-card-{{ section.id }}">
          <div class="wck-icon-wrap-{{ section.id }}"><span aria-hidden="true">🍃</span></div>
          <h3 class="wck-card-title-{{ section.id }}">Natural coconut & aloe</h3>
          <p class="wck-card-desc-{{ section.id }}">Powered by Caribbean coconut, aloe vera, and island botanical extracts.</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Why Caribe Kit",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container-fluid",
      "options": [
        { "value": "container-fluid", "label": "Default" },
        { "value": "w-full", "label": "Full width" },
        { "value": "container", "label": "Use container box" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 140,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 140,
      "step": 5,
      "default": 80
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "Why Caribe Kit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quietly considered, thoroughly proven"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji)",
          "default": "🌊"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Dermatologically tested"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Skin-safe formulations approved by independent dermatologists."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Caribe Kit",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "🌊",
            "title": "Dermatologically tested",
            "text": "Skin-safe formulations approved by independent dermatologists."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🧴",
            "title": "Cruelty-free & vegan",
            "text": "Never tested on animals. 100% vegan ingredients across the range."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🍃",
            "title": "Natural coconut & aloe",
            "text": "Powered by Caribbean coconut, aloe vera, and island botanical extracts."
          }
        }
      ]
    }
  ]
}
{% endschema %}
