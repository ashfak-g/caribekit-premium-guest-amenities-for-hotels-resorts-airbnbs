{%- comment -%}── Toast ──{%- endcomment -%}
<div class="gf-toast-{{ section.id }}" id="gf-toast-{{ section.id }}" aria-live="polite"></div>
<script>
(function () {
  'use strict';
  const SID = '{{ section.id }}';
  /* ── helpers ── */
  const $ = (id) => document.getElementById(id);
  const fmt = (cents) => {
    const dollars = (cents / 100).toFixed(2);
    return '$' + dollars;
  };
  /* ── State ── */
  /* cart = [ { variantId, title, price, image, quantity } ] */
  let cart = [];
  /* ── DOM refs ── */
  const drawer   = $(`gf-drawer-${SID}`);
  const overlay  = $(`gf-overlay-${SID}`);
  const closeBtn = $(`gf-close-${SID}`);
  const itemsEl  = $(`gf-items-${SID}`);
  const emptyEl  = $(`gf-empty-${SID}`);
  const footerEl = $(`gf-footer-${SID}`);
  const subtotal = $(`gf-subtotal-${SID}`);
  const fab      = $(`gf-fab-${SID}`);
  const fabBadge = $(`gf-fab-badge-${SID}`);
  const toast    = $(`gf-toast-${SID}`);
  /* ── Cart open/close ── */
  function openCart() {
    drawer.classList.add(`gf-open-${SID}`);
    overlay.classList.add(`gf-open-${SID}`);
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeCart() {
    drawer.classList.remove(`gf-open-${SID}`);
    overlay.classList.remove(`gf-open-${SID}`);
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  closeBtn.addEventListener('click', closeCart);
  overlay.addEventListener('click', closeCart);
  fab.addEventListener('click', openCart);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeCart();
  });
  /* ── Toast helper ── */
  let toastTimer;
  function showToast(msg) {
    toast.textContent = msg;
    toast.classList.add(`gf-toast-show-${SID}`);
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.remove(`gf-toast-show-${SID}`);
    }, 2500);
  }
  /* ── Render cart drawer ── */
  function renderCart() {
    const lineItems = itemsEl.querySelectorAll(`.gf-cart-item-${SID}`);
    lineItems.forEach(el => el.remove());
    if (cart.length === 0) {
      emptyEl.style.display = '';
      footerEl.style.display = 'none';
      fab.classList.remove(`gf-fab-visible-${SID}`);
      fabBadge.textContent = '0';
      return;
    }
    emptyEl.style.display = 'none';
    footerEl.style.display = '';
    let total = 0;
    let totalQty = 0;
    cart.forEach((item, idx) => {
      total    += item.price * item.quantity;
      totalQty += item.quantity;
      const el = document.createElement('div');
      el.className = `gf-cart-item-${SID}`;
      el.dataset.cartIdx = idx;
      el.innerHTML = `
        <img src="${item.image}" alt="${item.title}" class="gf-item-img-${SID}" width="64" height="64">
        <div class="gf-item-info-${SID}">
          <p class="gf-item-name-${SID}">${item.title}</p>
          <p class="gf-item-price-${SID}">${fmt(item.price)}</p>
          <div class="gf-item-qty-${SID}">
            <button class="gf-item-qty-btn-${SID}" data-action="cart-decrease" data-idx="${idx}" aria-label="Decrease quantity">−</button>
            <span class="gf-item-qty-val-${SID}">${item.quantity}</span>
            <button class="gf-item-qty-btn-${SID}" data-action="cart-increase" data-idx="${idx}" aria-label="Increase quantity">+</button>
          </div>
        </div>
        <button class="gf-item-remove-${SID}" data-action="cart-remove" data-idx="${idx}" aria-label="Remove ${item.title}">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M2 3h10M5 3V2h4v1M5 6v5M9 6v5M3 3l1 9h6l1-9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      `;
      itemsEl.appendChild(el);
    });
    subtotal.textContent = fmt(total);
    fab.classList.add(`gf-fab-visible-${SID}`);
    fabBadge.textContent = totalQty;
  }
  /* ── Delegate cart item events ── */
  itemsEl.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    const action = btn.dataset.action;
    const idx    = parseInt(btn.dataset.idx, 10);
    if (action === 'cart-increase') {
      cart[idx].quantity++;
      syncCartWithShopify(cart[idx].variantId, cart[idx].quantity);
      renderCart();
    } else if (action === 'cart-decrease') {
      cart[idx].quantity--;
      if (cart[idx].quantity <= 0) {
        syncCartWithShopify(cart[idx].variantId, 0);
        cart.splice(idx, 1);
      } else {
        syncCartWithShopify(cart[idx].variantId, cart[idx].quantity);
      }
      renderCart();
    } else if (action === 'cart-remove') {
      syncCartWithShopify(cart[idx].variantId, 0);
      cart.splice(idx, 1);
      renderCart();
    }
  });
  /* ── Shopify AJAX: add to cart ── */
  async function addToCart(variantId, quantity) {
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: variantId, quantity: quantity })
      });
      if (!res.ok) throw new Error('Cart add failed');
      return await res.json();
    } catch (err) {
      console.warn('Cart add error (possibly preview mode):', err);
      return null;
    }
  }
  /* ── Shopify AJAX: update quantity ── */
  async function syncCartWithShopify(variantId, quantity) {
    try {
      await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: variantId, quantity: quantity })
      });
    } catch (err) {
      console.warn('Cart sync error:', err);
    }
  }
  /* ── Card event delegation ── */
  const section = document.getElementById(`gf-section-${SID}`);
  section.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    const action = btn.dataset.action;
    const card   = btn.closest(`.gf-card-${SID}`);
    if (!card) return;
    const variantId = parseInt(card.dataset.variantId, 10);
    const title     = card.dataset.productTitle;
    const price     = parseInt(card.dataset.productPrice, 10);
    const image     = card.dataset.productImage;
    if (action === 'quick-shop' || action === 'add-to-cart') {
      /* get quantity from the card's qty display */
      const qtyEl = card.querySelector(`.gf-qty-val-${SID}`);
      const qty   = parseInt(qtyEl ? qtyEl.textContent : '1', 10) || 1;
      const addBtn = card.querySelector(`[data-action="add-to-cart"]`);
      if (addBtn) {
        addBtn.textContent = '...';
        addBtn.classList.add(`gf-adding-${SID}`);
      }
      await addToCart(variantId, qty);
      /* update local cart state */
      const existing = cart.find(i => i.variantId === variantId);
      if (existing) {
        existing.quantity += qty;
      } else {
        cart.push({ variantId, title, price, image, quantity: qty });
      }
      renderCart();
      if (addBtn) {
        addBtn.textContent = 'Added ✓';
        setTimeout(() => {
          addBtn.textContent = 'Add +';
          addBtn.classList.remove(`gf-adding-${SID}`);
        }, 1400);
      }
      showToast(`${title} added to cart`);
      openCart();
    }
  });
  /* ── Quantity controls on product cards ── */
  section.addEventListener('click', (e) => {
    const btn = e.target.closest(`.gf-qty-btn-${SID}`);
    if (!btn) return;
    const action  = btn.dataset.action;
    const qtyEl   = btn.parentElement.querySelector(`.gf-qty-val-${SID}`);
    let qty = parseInt(qtyEl.textContent, 10) || 1;
    if (action === 'decrease') { qty = Math.max(1, qty - 1); }
    if (action === 'increase') { qty = Math.min(99, qty + 1); }
    qtyEl.textContent = qty;
  });
  /* ── Init: load existing cart from Shopify ── */
  (async function initCart() {
    try {
      const res  = await fetch('/cart.js', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      if (!res.ok) return;
      const data = await res.json();
      if (data.items && data.items.length > 0) {
        cart = data.items.map(item => ({
          variantId: item.variant_id,
          title    : item.product_title,
          price    : item.price,
          image    : item.featured_image ? item.featured_image.url : item.image,
          quantity : item.quantity
        }));
        renderCart();
      }
    } catch (_) {
      /* Silently fail in theme editor preview */
    }
  })();
})();
</script>
